# Klucz API Resend — wygeneruj na https://resend.com/api-keys
# Tylko po stronie serwera — NIE dodawaj prefiksu NEXT_PUBLIC_.
RESEND_API_KEY=

# Token Vercel Blob (odczyt/zapis) — utwórz Blob store w Vercel:
# Project → Storage → Create Database → Blob. Token jest wtedy dodawany
# automatycznie w produkcji/preview; do developmentu ściągnij go przez
# `vercel env pull` albo wklej tutaj ręcznie.
BLOB_READ_WRITE_TOKEN=

# Connection string do bazy Postgres (system opinii, tabela `reviews`,
# tworzona automatycznie przy pierwszym zapytaniu). Do developmentu
# ściągnij przez `vercel env pull` albo wklej tutaj ręcznie.
DATABASE_URL=

# Hasło do panelu moderacji opinii (/admin/opinie). Tylko po stronie
# serwera — służy też jako klucz do podpisywania sesji logowania.
ADMIN_PASSWORD=
